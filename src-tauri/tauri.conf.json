{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pit Desk",
  "version": "../package.json",
  "identifier": "io.github.bapirlo07.pitdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pit Desk",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0f1215"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Race-weekend IT service desk triage",
    "longDescription": "Log tickets, get an ITIL-style impact × urgency priority, work through first-line checks and generate factual escalation notes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
